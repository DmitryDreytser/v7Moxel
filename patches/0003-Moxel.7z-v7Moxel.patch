+        // EMF units are pixels at the EMF DPI; PDF content stream is in points.
+        // Мы выставляем cm( scale 0 0 -scale 0 pageH ) и затем применяем world transform.
+        private double _mxA = 1, _mxB = 0, _mxC = 0, _mxD = 1, _mxE = 0, _myF = 0;
