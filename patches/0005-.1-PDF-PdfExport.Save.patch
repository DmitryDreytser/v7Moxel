- SaveWrapper.SaveToPDF сведён к тонкой обёртке над PdfExport.Save (60 строк
  дублирующей логики PrintWrapper/ReadFromCSheetDoc/Pechkin удалены); добавлен
  параметр PdfEngine (по умолчанию Auto — поведение перехвата диалога не меняется)
- Converter: реализован отсутствовавший метод SavePdf из IConverter (блокировал
  компиляцию); Save(...,PDF) теперь передаёт выбранное свойство ФорматPDF
- Убраны двойные GC.Collect в finally Converter.Save и в IInitDone.Done
  (AddIn.cs): один сбор после FinalReleaseComObject достаточно; очистка модели
  выполняется в Moxel.Dispose
- Проверено: все вызовы CaptureToPdf/LoadMoxelFromMemory соответствуют сигнатурам
---
 v7Moxel/Moxel/AddIn/AddIn.cs       |  6 +--
 v7Moxel/Moxel/AddIn/Converter.cs   | 19 +++++++--
 v7Moxel/Moxel/AddIn/SaveWrapper.cs | 65 ++++--------------------------
 3 files changed, 27 insertions(+), 63 deletions(-)

diff --git a/v7Moxel/Moxel/AddIn/AddIn.cs b/v7Moxel/Moxel/AddIn/AddIn.cs
index 62f78ee..a7c2d8e 100644
--- a/v7Moxel/Moxel/AddIn/AddIn.cs
+++ b/v7Moxel/Moxel/AddIn/AddIn.cs
@@ -315,10 +315,10 @@ namespace Moxel
                 }
             }
 
+            // РЕФАКТОРИНГ (п.1): вместо двух принудительных GC.Collect — один сбор за
+            // мусором после освобождения COM-объектов; двойной Collect + WaitForPendingFinalizers
+            // на выгрузке аддина избыточен и подвешивал поток 1С.
             GC.Collect();
-            GC.Collect();
-            GC.WaitForPendingFinalizers();
-
             Marshal.CleanupUnusedObjectsInCurrentContext();
             return HRESULT.S_OK;
         }
diff --git a/v7Moxel/Moxel/AddIn/Converter.cs b/v7Moxel/Moxel/AddIn/Converter.cs
index 8dc8bcf..24cdd04 100644
--- a/v7Moxel/Moxel/AddIn/Converter.cs
+++ b/v7Moxel/Moxel/AddIn/Converter.cs
@@ -156,7 +156,7 @@ namespace Moxel
                 if (_attachedTable != null)
                 {
                     if (format == SaveFormat.PDF)
-                        SaveWrapper.SaveToPDF(_attachedTable.Context.SheetDoc.Pointer, filename, _attachedTable);
+                        SaveWrapper.SaveToPDF(_attachedTable.Context.SheetDoc.Pointer, filename, _attachedTable, _pdfEngine);
                     else
                         SaveWrapper.WrapperSaveAs(_attachedTable.Context.SheetDoc.Pointer, filename, (int)format);
 
@@ -199,11 +199,24 @@ namespace Moxel
             {
                 mxl?.Dispose();
                 mxl = null;
-                GC.Collect();
-                GC.Collect();
             }
         }
 
+        /// <summary>Запись присоединённой таблицы в PDF выбранным движком
+        /// (без влияния на свойство ФорматPDF). Возвращает имя файла.</summary>
+        public string SavePdf(string filename, PdfEngine engine)
+        {
+            if (_attachedTable == null)
+                throw new Exception("Таблица не присоединена. Вызовите Присоединить() / Attach().");
+
+            // РЕФАКТОРИНГ (п.1): единая точка выхода PDF — PdfExport.Save.
+            // GC.Collect отсюда убран: очистка кэшей модели выполняется в Dispose.
+            if (!SaveWrapper.SaveToPDF(_attachedTable.Context.SheetDoc.Pointer, filename, _attachedTable, engine))
+                throw new Exception($"Не удалось записать PDF ({engine}): {PdfExport.LastError}");
+
+            return filename;
+        }
+
 
         #region AddIn events
 
diff --git a/v7Moxel/Moxel/AddIn/SaveWrapper.cs b/v7Moxel/Moxel/AddIn/SaveWrapper.cs
index dac4273..b4f76a6 100644
--- a/v7Moxel/Moxel/AddIn/SaveWrapper.cs
+++ b/v7Moxel/Moxel/AddIn/SaveWrapper.cs
@@ -243,65 +243,16 @@ namespace Moxel
             return 0;
         }
 
-        public static int SaveToPDF(IntPtr pSheetDoc, string FileName, V7Table table = null)
+        // РЕФАКТОРИНГ (п.1): весь вывод PDF идёт через единую точку PdfExport.Save
